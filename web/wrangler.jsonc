{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dino-party",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
